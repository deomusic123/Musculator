# Valores publicos seguros para el cliente
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Persistencia server-side para musculacion sin auth en cliente
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_DEV_EMAIL=dev@musculator.local
SUPABASE_DEV_DISPLAY_NAME=Musculator Dev

# Solo runtime server de Next.js
N8N_WORKOUT_WEBHOOK_URL=https://n8n.example.com/webhook/workout-intake
N8N_WORKOUT_WEBHOOK_SECRET=replace-me

# Configurar tambien este redirect URL en Supabase Auth:
# http://localhost:3000/auth/callback

# No agregar aqui service role ni API keys de proveedores de IA.
